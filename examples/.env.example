# Shared config for the examples/ CLIs. Copy to examples/.env and load with:
#   node --env-file=examples/.env examples/satora-cli-arkade.js ...
#
# A single seed backs every example wallet (Arkade, EVM, Bitcoin, Spark) — each
# example derives its chain-specific WDK wallet account from it. The protocol
# itself needs no secret: the swap key is derived from the wallet account.

# Persistent BIP-39 seed shared by all example wallets. REQUIRED. Keep it secret;
# the wallet must hold funds on the source chain you swap from.
SATORA_MNEMONIC="twelve word seed phrase goes here ..."

# Satora API (optional; production default).
SATORA_BASE_URL=https://api.satora.io/

# SQLite database for the swap client (key index + per-swap state) so an
# interrupted swap survives a restart and can be recovered/refunded. Optional.
SATORA_DB=./.satora.db

# ── Bitcoin / Arkade (used by the arkade & bitcoin examples) ──────────────────
SATORA_ESPLORA=https://mempool.space/api
SATORA_ARKADE_SERVER=https://arkade.computer
# The WDK Bitcoin wallet's backend: an Electrum SSL server (host:port), or a
# Blockbook API URL (takes precedence when set). Optional.
SATORA_BTC_ELECTRUM=electrum.blockstream.info:50002
# SATORA_BTC_BLOCKBOOK=https://btc1.trezor.io/api
# On-chain Bitcoin fee rate (sat/vB) for the btc example's send/funding tx, and
# for the on-chain EVM -> Bitcoin claim in the evm example. Optional (the
# wallet estimates one otherwise).
SATORA_BTC_FEE_RATE=2

# ── EVM (used by the evm example) ─────────────────────────────────────────────
# RPC for the source EVM chain (falls back to a public RPC per chain).
SATORA_EVM_RPC=https://arb1.arbitrum.io/rpc

# ── Spark / Lightning (used by the spark example) ─────────────────────────────
# Max Lightning routing fee (sats) when paying the swap invoice.
SATORA_SPARK_MAX_FEE_SATS=100
